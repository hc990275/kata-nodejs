#!/bin/bash
set -e
ulimit -n 65535 2>/dev/null || ulimit -n 4096 2>/dev/null || true

# ================== 端口设置 ==================
export TUIC_PORT=${TUIC_PORT:-"3083"}      # UDP 协议
export HY2_PORT=${HY2_PORT:-""}
export REALITY_PORT=${REALITY_PORT:-"3083"}  # TCP 协议 (与 TUIC 共用同一端口)

# ================== 强制切换到脚本所在目录 ==================
cd "$(dirname "$0")"

# ================== 环境变量 & 绝对路径 ==================
export FILE_PATH="${PWD}/.npm"
export DATA_PATH="${PWD}/singbox_data"
mkdir -p "$FILE_PATH" "$DATA_PATH"
export XDG_DATA_HOME="/tmp/.singbox_data"
export XDG_CACHE_HOME="/tmp/.singbox_cache"
export TMPDIR="/tmp"
rm -rf ~/.npm/_logs/* ./npm-debug.log* "${DATA_PATH}"/* /tmp/.singbox_* 2>/dev/null || true

# ================== UUID 固定保存 ==================
UUID_FILE="${FILE_PATH}/uuid.txt"
if [ -f "$UUID_FILE" ]; then
  UUID=$(cat "$UUID_FILE")
  echo -e "\e[1;33m[UUID] 复用固定 UUID: $UUID\e[0m"
else
  UUID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "$RANDOM-$RANDOM-$RANDOM-$RANDOM")
  echo "$UUID" > "$UUID_FILE"
  chmod 600 "$UUID_FILE"
  echo -e "\e[1;32m[UUID] 首次生成并永久保存: $UUID\e[0m"
fi

# ================== 动态获取最新版本 & 下载 sing-box ==================
SINGBOX_VER=$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases/latest | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/' || true)
[ -z "$SINGBOX_VER" ] && SINGBOX_VER="1.12.0"

ARCH=$(uname -m)
case "$ARCH" in
  x86_64|amd64)  ARCH_NAME="amd64" ;;
  aarch64|arm64) ARCH_NAME="arm64" ;;
  s390x)         ARCH_NAME="s390x" ;;
  *) echo "不支持的架构: $ARCH"; exit 1 ;;
esac

DOWNLOAD_URL="https://github.com/SagerNet/sing-box/releases/download/v${SINGBOX_VER}/sing-box-${SINGBOX_VER}-linux-${ARCH_NAME}.tar.gz"

SINGBOX_BIN="${FILE_PATH}/sb_core"
if [ ! -f "$SINGBOX_BIN" ]; then
  echo -e "\e[1;33m[下载] 未检测到 Sing-box 核心，正在下载 v${SINGBOX_VER}...\e[0m"
  curl -L -sS -o "${FILE_PATH}/singbox.tar.gz" "$DOWNLOAD_URL"
  
  # 借鉴上一版：精准解压单个文件，不留残余垃圾
  tar -zxvf "${FILE_PATH}/singbox.tar.gz" -C "${FILE_PATH}" --strip-components=1 "sing-box-${SINGBOX_VER}-linux-${ARCH_NAME}/sing-box" >/dev/null 2>&1 || \
  tar -zxvf "${FILE_PATH}/singbox.tar.gz" -C "${FILE_PATH}" --wildcards "*/sing-box" --strip-components=1 >/dev/null 2>&1
  
  mv "${FILE_PATH}/sing-box" "$SINGBOX_BIN" 2>/dev/null || true
  rm -f "${FILE_PATH}/singbox.tar.gz"
  chmod +x "$SINGBOX_BIN"
else
  echo -e "\e[1;32m[核心] 已存在 Sing-box 核心，跳过下载\e[0m"
fi

# ================== 按需生成 Reality 密钥 ==================
private_key=""
public_key=""
KEY_FILE="${FILE_PATH}/key.txt"

if [ -n "$REALITY_PORT" ] && [ "$REALITY_PORT" != "0" ]; then
  if [ -f "$KEY_FILE" ]; then
    echo -e "\e[1;33m[密钥] 复用已有 Reality 密钥...\e[0m"
    private_key=$(grep "PrivateKey:" "$KEY_FILE" | awk '{print $2}')
    public_key=$(grep "PublicKey:" "$KEY_FILE" | awk '{print $2}')
  else
    echo -e "\e[1;33m[密钥] 首次生成 Reality 密钥对...\e[0m"
    output=$("$SINGBOX_BIN" generate reality-keypair)
    echo "$output" > "$KEY_FILE"
    private_key=$(echo "$output" | awk '/PrivateKey:/ {print $2}')
    public_key=$(echo "$output" | awk '/PublicKey:/ {print $2}')
    chmod 600 "$KEY_FILE"
  fi
fi

# ================== 按需生成证书（仅 TUIC / HY2 需要） ==================
if { [ -n "$TUIC_PORT" ] && [ "$TUIC_PORT" != "0" ]; } || { [ -n "$HY2_PORT" ] && [ "$HY2_PORT" != "0" ]; }; then
  if [ ! -f "${FILE_PATH}/cert.pem" ]; then
    if command -v openssl >/dev/null 2>&1; then
      openssl ecparam -genkey -name prime256v1 -out "${FILE_PATH}/private.key" 2>/dev/null
      openssl req -new -x509 -days 3650 -key "${FILE_PATH}/private.key" -out "${FILE_PATH}/cert.pem" -subj "/CN=bing.com" 2>/dev/null
    else
      cat > "${FILE_PATH}/private.key" <<'EOF'
-----BEGIN EC PARAMETERS-----
BgqghkjOPQQBw==
-----END EC PARAMETERS-----
-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIM4792SEtPqIt1ywqTd/0bYidBqpYV/+siNnfBYsdUYsAoGCCqGSM49
AwEHoUQDQgAE1kHafPj07rJG+HboH2ekAI4r+e6TL38GWASAnngZreoQDF16ARa
/TsyLyFoPkhTxSbehH/OBEjHtSZGaDhMqQ==
-----END EC PRIVATE KEY-----
EOF
      cat > "${FILE_PATH}/cert.pem" <<'EOF'
-----BEGIN CERTIFICATE-----
MIIBejCCASGgAwIBAgIUFWeQL3556PNJLp/veCFxGNj9crkwCgYIKoZIzj0EAwIw
EzERMA8GA1UEAwwIYmluZy5jb20wHhcNMjUwMTAxMDEwMTAwWhcNMzUwMTAxMDEw
MTAwWjATMREwDwYDVQQDDAhiaW5nLmNvbTBNBgqgGzM9AgEGCCqGSM49AwEHA0IA
BNZB2nz49O6yRvh26B9npACOK/nuky9/BlgEgDZ54Ga3qEAxdeWv07Mi8h
d5IR8Um3oR/zQRIx7UmRmg4TKmjUzBRMB0GA1UdDgQWBQTV1cFID7UISE7PLTBR
BfGbgrkMNzAfBgNVHSMEGDAWgBTV1cFID7UISE7PLTBRBfGbgrkMNzAPBgNVHRMB
Af8EBTADAQH/MAoGCCqGSM49BAMCA0cAMEQCIARDAJvg0vd/ytrQVvEcSm6XTlB+
eQ6OFb9LbLYL9Zi+AiffoMbi4y/0YUQlTtz7as9S8/lciBF5VCUoVIKS+vX2g==
-----END CERTIFICATE-----
EOF
    fi
    chmod 600 "${FILE_PATH}/private.key"
  fi
fi

# ================== 生成 config.json (兼容 Sing-box 1.12+ 规范) ==================
cat > "${FILE_PATH}/config.json" <<EOF
{
  "log": {
    "disabled": true
  },
  "inbounds": [$( \
    [ "$TUIC_PORT" != "" ] && [ "$TUIC_PORT" != "0" ] && echo "{
      \"type\": \"tuic\",
      \"listen\": \"::\",
      \"listen_port\": $TUIC_PORT,
      \"users\": [{\"uuid\": \"$UUID\", \"password\": \"admin\"}],
      \"congestion_control\": \"bbr\",
      \"zero_rtt_handshake\": true,
      \"heartbeat\": \"10s\",
      \"tls\": {
        \"enabled\": true,
        \"server_name\": \"www.bing.com\",
        \"alpn\": [\"h3\"],
        \"certificate_path\": \"${FILE_PATH}/cert.pem\",
        \"key_path\": \"${FILE_PATH}/private.key\"
      }
    },"; \
    [ "$HY2_PORT" != "" ] && [ "$HY2_PORT" != "0" ] && echo "{
      \"type\": \"hysteria2\",
      \"listen\": \"::\",
      \"listen_port\": $HY2_PORT,
      \"users\": [{\"password\": \"$UUID\"}],
      \"ignore_client_bandwidth\": true,
      \"masquerade\": \"https://bing.com\",
      \"tls\": {
        \"enabled\": true,
        \"alpn\": [\"h3\"],
        \"certificate_path\": \"${FILE_PATH}/cert.pem\",
        \"key_path\": \"${FILE_PATH}/private.key\"
      }
    },"; \
    [ "$REALITY_PORT" != "" ] && [ "$REALITY_PORT" != "0" ] && echo "{
      \"type\": \"vless\",
      \"listen\": \"::\",
      \"listen_port\": $REALITY_PORT,
      \"users\": [{\"uuid\": \"$UUID\", \"flow\": \"xtls-rprx-vision\"}],
      \"tls\": {
        \"enabled\": true,
        \"server_name\": \"www.samsung.com\",
        \"reality\": {
          \"enabled\": true,
          \"handshake\": {\"server\": \"www.samsung.com\", \"server_port\": 443},
          \"private_key\": \"$private_key\",
          \"short_id\": [\"\"]
        }
      }
    },"; \
  )],
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "udp",
        "server": "1.1.1.1"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
EOF

# 清理末尾多余的逗号，保证严格的 JSON 规范
sed -i 's/},]/}]/g' "${FILE_PATH}/config.json"

# ================== 启动 Sing-box (极轻内存与 CPU 优化参数) ==================
FSNOTIFY_BACKEND=disabled GOGC=30 GOMEMLIMIT=90MiB "$SINGBOX_BIN" run -c "${FILE_PATH}/config.json" &
SINGBOX_PID=$!
echo "[SING-BOX] 启动完成 PID=$SINGBOX_PID"

# ================== 获取 IP & ISP ==================
IP=$(curl -s --max-time 2 ipv4.ip.sb || curl -s --max-time 1 api.ipify.org || echo "IP_ERROR")
ISP=$(curl -s --max-time 2 https://speed.cloudflare.com/meta | awk -F'"' '{print $26"-"$18}' || echo "0.0")

# ================== 生成节点订阅链接 ==================
> "${FILE_PATH}/list.txt"
[ "$TUIC_PORT" != "" ] && [ "$TUIC_PORT" != "0" ] && echo "tuic://${UUID}:admin@${IP}:${TUIC_PORT}?sni=www.bing.com&alpn=h3&congestion_control=bbr&allowInsecure=1#tuic_${ISP}" >> "${FILE_PATH}/list.txt"
[ "$HY2_PORT" != "" ] && [ "$HY2_PORT" != "0" ] && echo "hysteria2://${UUID}@${IP}:${HY2_PORT}/?sni=www.bing.com&insecure=1#hy2_${ISP}" >> "${FILE_PATH}/list.txt"
[ "$REALITY_PORT" != "" ] && [ "$REALITY_PORT" != "0" ] && echo "vless://${UUID}@${IP}:${REALITY_PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.samsung.com&fp=chrome&pbk=${public_key}&type=tcp#vless_reality_${ISP}" >> "${FILE_PATH}/list.txt"

base64 "${FILE_PATH}/list.txt" | tr -d '\n' > "${FILE_PATH}/sub.txt"
echo -e "\n---------------- [节点明文列表] ----------------"
cat "${FILE_PATH}/list.txt"
echo -e "------------------------------------------------\n"
echo -e "\e[1;32m订阅 Base64 已保存至: ${FILE_PATH}/sub.txt\e[0m"

# ================== 启动定时重启（低 CPU 耗损守护） ==================
schedule_restart() {
  echo "[定时重启:Sing-box] 守护进程已启动（预计每日北京时间 00:03 执行）"
  LAST_RESTART_DAY=-1

  while true; do
    now_ts=$(date +%s)
    beijing_ts=$((now_ts + 28800))
    H=$(( (beijing_ts / 3600) % 24 ))
    M=$(( (beijing_ts / 60) % 60 ))
    D=$(( beijing_ts / 86400 ))

    if [ "$H" -eq 0 ] && [ "$M" -eq 3 ] && [ "$D" -ne "$LAST_RESTART_DAY" ]; then
      echo "[定时重启:Sing-box] 到达北京时间 00:03 → 正在重启核心"
      LAST_RESTART_DAY=$D

      kill "$SINGBOX_PID" 2>/dev/null || true
      sleep 3

      rm -rf ~/.npm/_logs/* ./npm-debug.log* "${DATA_PATH}"/* /tmp/.singbox_* 2>/dev/null || true

      FSNOTIFY_BACKEND=disabled GOGC=30 GOMEMLIMIT=90MiB "$SINGBOX_BIN" run -c "${FILE_PATH}/config.json" &
      SINGBOX_PID=$!

      echo "[Sing-box] 重启完成，新 PID: $SINGBOX_PID"
    fi

    # 每 30 秒进行一次纯算术轮询，使得 CPU 占用率接近 0%
    sleep 30
  done
}

schedule_restart
